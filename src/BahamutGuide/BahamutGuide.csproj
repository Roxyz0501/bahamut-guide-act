<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>BahamutGuide</AssemblyName>
    <RootNamespace>BahamutGuide</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Roxyz0501</Authors>
    <Company>Roxyz0501</Company>
    <Product>Bahamut Guide for ACT</Product>
    <Description>Bahamut mechanic image groups and opt-in local SPESPE timeline source updates for ACT.</Description>
    <ActPath Condition="'$(ActPath)' == ''">C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Advanced Combat Tracker"><HintPath>$(ActPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing" /><Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
